{
  "permissions": {
    "allow": [
      "Bash(docker compose ps)",
      "Bash(docker compose ps *)",
      "Bash(docker compose config)",
      "Bash(docker compose config *)",
      "Bash(docker compose logs *)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-edit.sh"
          }
        ]
      }
    ]
  }
}
